# Dougo — environment variables
#
# Local development:
#   cp .env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
# So in dev, .env.development is picked up by both `pnpm dev` and the db scripts.
#
# Keep this file minimal: provider credentials (payments, OAuth, email,
# storage, AI, analytics) are configured in the admin panel → Settings and
# stored in the database (encrypted when CONFIG_ENCRYPTION_KEY is set).
# Env vars with the matching names still work as fallbacks — database values
# take precedence — but they don't need to live in this template.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Dougo
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Extra origins allowed to call the auth API (comma-separated). A leading dot
# is a hostname-suffix wildcard, e.g. `.e2b.app` for cloud-sandbox previews.
AUTH_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# App (optional — sensible defaults exist in src/config/index.ts)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION=An open playground for AI decisions
VITE_APP_LOGO=/logo.png
VITE_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Admin settings encryption (recommended)
# ---------------------------------------------------------------------------
# Encrypts secrets saved via admin Settings (AES-256-GCM) in the config table.
# Unset = plaintext storage. Once set, keep it stable — rotating or removing
# it orphans already-encrypted values (they fall back to env values).
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (advanced / non-sqlite)
# ---------------------------------------------------------------------------
# DATABASE_PROVIDER options: sqlite | postgres | mysql | turso | d1
#   PostgreSQL: postgresql://user:pass@localhost:5432/dbname
#   MySQL:      mysql://user:pass@localhost:3306/dbname
#   Turso:      libsql://<db>.turso.io   (also set DATABASE_AUTH_TOKEN below)
# DATABASE_AUTH_TOKEN=                # Turso auth token (required for turso)
# DB_SCHEMA=public                    # Postgres schema
# DB_SINGLETON_ENABLED=false          # reuse a single connection (serverless)
# DB_MAX_CONNECTIONS=1

# ---------------------------------------------------------------------------
# Auth (optional — AUTH_URL defaults to VITE_APP_URL)
# ---------------------------------------------------------------------------
# AUTH_URL=http://localhost:3000
# Keep local login until the BambooNode OAuth client is registered and tested.
AUTH_MODE=local
# Server-only; never use VITE_ prefixes for these credentials.
# BAMBOONODE_ISSUER=https://api.bamboonode.dev
# BAMBOONODE_AUTHORIZATION_URL=https://bamboonode.dev/oauth/authorize
# BAMBOONODE_TOKEN_URL=https://api.bamboonode.dev/oauth/token
# BAMBOONODE_USERINFO_URL=https://api.bamboonode.dev/oauth/userinfo
# BAMBOONODE_CLIENT_ID=
# BAMBOONODE_CLIENT_SECRET=
# BAMBOONODE_SCOPES=openid profile email
# BAMBOONODE_TOKEN_AUTH_METHOD=post
# Optional account-management link; only the public frontend origin is allowed.
# BAMBOONODE_ACCOUNT_URL=https://bamboonode.dev

# Decision Arena vault: required to save API keys, min 32 characters.
# Local setup generates this automatically. Use Workers Secrets in production.
ARENA_ENCRYPTION_KEY=
# Node local bridge only; never expose the runner to the public Internet.
ARENA_INTERNAL_SECRET=
ARENA_RUNNER_URL=http://127.0.0.1:5092
