{
  "name": "decision-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:cloudflare": "node scripts/dev-cloudflare.mjs",
    "build:local-production": "node scripts/build-local-production.mjs",
    "start:local-production": "node scripts/start-local-production.mjs",
    "build": "pnpm --filter @decision-arena/web build && pnpm --filter @decision-arena/runner build",
    "build:cloudflare": "pnpm --filter @decision-arena/web cf:build && pnpm --filter @decision-arena/runner build",
    "test": "vitest run",
    "test:cloudflare": "node scripts/smoke-cloudflare.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @decision-arena/web exec tsc --noEmit",
    "setup:local": "node scripts/setup.mjs",
    "test:runner": "pnpm --filter @decision-arena/runner build && vitest run --config vitest.runner.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "tsx": "^4.21.0",
    "wrangler": "4.98.0",
    "miniflare": "4.20260603.0"
  }
}
